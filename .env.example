# Copy to .env; these defaults also work without a .env file in Docker Compose.
POSTGRES_PASSWORD=lenny_local_dev
DATABASE_URL=postgresql+asyncpg://lenny:lenny_local_dev@localhost:5432/lenny
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Smaller context helps on 8 GB machines; CPU prompt evaluation may be slow.
OLLAMA_CONTEXT=8192
OLLAMA_MAX_TOKENS=2800
MODEL_TIMEOUT=600
EMBEDDING_MODEL=nomic-embed-text
DEFAULT_LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
RETRIEVAL_THRESHOLD=0.55
TOP_K=5
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
